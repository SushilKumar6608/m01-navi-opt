# Copy this file to .env and fill in real values. Never commit the real .env.

# Copernicus Marine Service (CMEMS) — free account at https://data.marine.copernicus.eu/register
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Kafka (defaults match infra/docker-compose.yml — change only if you edit that file)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Airflow webserver login (defaults match infra/docker-compose.yml airflow-init command)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# FastAPI service
API_HOST=0.0.0.0
API_PORT=8000
